# Salin ke .env (jangan di-commit) dan isi nilainya.
# Keduanya bukan rahasia (ID/nama publik), tetapi tetap konfigurasi lokal.
#
# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 "Web client ID" (Firebase > Authentication > Google).
# Opsional jika google-services.json memuat default_web_client_id.
GOOGLE_WEB_CLIENT_ID=
# AI_MODEL_NAME: model Firebase AI Logic. Kosongkan untuk default (gemini-3.8-flash).
AI_MODEL_NAME=
